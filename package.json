    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\""
  },
  "engines": {
    "node": ">=18"
  },
  "readmeFilename": "README.md",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-metarhia": "^10.0.1",
